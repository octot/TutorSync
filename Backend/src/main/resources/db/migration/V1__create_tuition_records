CREATE TABLE tuition_records (
    id UUID PRIMARY KEY,
    tuition_id VARCHAR(100) NOT NULL UNIQUE,
    tutor_name VARCHAR(150) NOT NULL,
    tutor_number VARCHAR(20) NOT NULL,
    parent_name VARCHAR(150),
    parent_number VARCHAR(20) NOT NULL,
    start_time VARCHAR(10) NOT NULL,
    end_time VARCHAR(10) NOT NULL,
    time_zone VARCHAR(100) NOT NULL,
    payment_from_parent VARCHAR(100),
    payment_to_tutor VARCHAR(100),
    additional_message_to_tutor TEXT,
    additional_message_to_parent TEXT,
    created_at TIMESTAMP NOT NULL,
    updated_at TIMESTAMP NOT NULL
);